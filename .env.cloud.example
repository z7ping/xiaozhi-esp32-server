# Copy to .env.cloud, then use: docker compose --env-file .env.cloud -f compose.cloud.yml up -d --build
XIAOZHI_WS_PORT=8000
XIAOZHI_HTTP_PORT=8003
XIAOZHI_MANAGER_PORT=8002
# Exactly the hostname in Jellyfin MCP's --audio-public-url (no scheme, no port).
# Example: MCP_MEDIA_ALLOWED_HOSTS=192.168.1.100
MCP_MEDIA_ALLOWED_HOSTS=
# Only needed when using --profile manager. Use a strong secret.
MYSQL_ROOT_PASSWORD=
