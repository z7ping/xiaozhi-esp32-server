# syntax=docker/dockerfile:1.7
# Lean Python-only runtime for MiMo cloud APIs + local ONNX VAD + Jellyfin MCP.
# Build: docker compose -f compose.cloud.yml build xiaozhi-server
FROM python:3.10-slim AS python-deps

WORKDIR /build
COPY main/xiaozhi-server/requirements-cloud.txt ./requirements-cloud.txt
# BuildKit caches wheels across dependency revisions. App-code changes reuse this layer.
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --disable-pip-version-check --prefer-binary \
      --prefix=/opt/python-deps -r requirements-cloud.txt

FROM python:3.10-slim
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Shanghai \
    LANG=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    XIAOZHI_DISABLED_PLUGINS=get_news_from_newsnow \
    XIAOZHI_PYDUB_OVERRIDE_FFMPEG=0

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates ffmpeg libopus0 libgomp1 && \
    rm -rf /var/lib/apt/lists/*

COPY --from=python-deps /opt/python-deps/ /usr/local/
WORKDIR /opt/xiaozhi-esp32-server
COPY main/xiaozhi-server/ ./

# Import smoke-check is network-free; fail the image build if dependencies drift.
RUN mkdir -p data tmp && python -m pip check && python scripts/cloud_smoke_test.py

EXPOSE 8000 8003
CMD ["python", "app.py"]
